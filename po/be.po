#: data/fingwit.desktop.in:3 fingwit:81 data/fingwit/fingwit.ui.h:9
msgid "Fingerprints"
msgstr "Адбіткі пальцаў"

#: data/fingwit.desktop.in:4 fingwit:134 data/fingwit/fingwit.ui.h:10
msgid "Fingerprint configuration tool"
msgstr "Інструмент налады адбіткаў пальцаў"

#: data/fingwit.desktop.in:11
msgid "fingerprint;authentication;security;biometric;"
msgstr "fingerprint, адбітак, пальцы, бяспека, біяметрыя, аўтэнтыкацыя"

#: fingwit:39
msgid "Right index finger"
msgstr "Правы ўказальны палец"

#: fingwit:40
msgid "Right middle finger"
msgstr "Правы сярэдні палец"

#: fingwit:41
msgid "Right ring finger"
msgstr "Правы безыменны палец"

#: fingwit:42
msgid "Right little finger"
msgstr "Правы мезенец"

#: fingwit:43
msgid "Right thumb"
msgstr "Правы вялікі палец"

#: fingwit:44
msgid "Left index finger"
msgstr "Левы ўказальны палец"

#: fingwit:45
msgid "Left middle finger"
msgstr "Левы сярэдні палец"

#: fingwit:46
msgid "Left ring finger"
msgstr "Левы безыменны палец"

#: fingwit:47
msgid "Left little finger"
msgstr "Левы мезенец"

#: fingwit:48
msgid "Left thumb"
msgstr "Левы вялікі палец"

#: fingwit:98
msgid "Disable fingerprint authentication"
msgstr "Адключыць аўтэнтыфікацыю па адбітках пальцаў"

#: fingwit:102 fingwit:132
msgid "About"
msgstr "Аб праграме"

#: fingwit:107
msgid "Quit"
msgstr "Выйсці"

#: fingwit:275
msgid "Place your finger on the scanner..."
msgstr "Прыкладзіце палец да сканера..."

#: fingwit:293
msgid "Well done! Your fingerprint was saved successfully."
msgstr "Выдатна! Ваш адбітак пальца паспяхова захаваны."

#: fingwit:299
#, python-format
msgid "Good scan (%d so far)! Do it again..."
msgstr "Добра прасканавана (на %d)! Прыкладзіце зноў..."

#: fingwit:302
msgid "Try again..."
msgstr "Паспрабуйце зноў..."

#: fingwit:305
msgid "Sorry, your fingerprint could not be saved."
msgstr "На жаль, ваш адбітак пальца не ўдалося захаваць."

#: fingwit:310
msgid "This fingerprint is already saved, use a different finger."
msgstr "Гэты адбітак ужо захаваны, скарыстайцеся іншым пальцам."

#: fingwit:315
msgid "This device cannot store any more fingerprints."
msgstr "Гэта прылада не можа захаваць больш адбіткаў пальцаў."

#: fingwit:320
msgid "An unknown error occured."
msgstr "Адбылася невядомая памылка."

#: data/fingwit/fingwit.ui.h:1
msgid "No fingerprint reader detected"
msgstr "Сканер адбіткаў пальцаў не знойдзены"

#: data/fingwit/fingwit.ui.h:2
msgid "Fingerprint authentication disabled"
msgstr "Аўтэнтыфікацыя па адбітках пальцаў адключана"

#: data/fingwit/fingwit.ui.h:3
msgid "Enable"
msgstr "Уключыць"

#: data/fingwit/fingwit.ui.h:4
msgid "Choose a finger to configure it:"
msgstr "Выберыце палец для налады:"

#: data/fingwit/fingwit.ui.h:5
msgid "Active fingerprints are highlighted in green."
msgstr "Актыўныя адбіткі пальцаў вылучаюцца зялёным колерам."

#: data/fingwit/fingwit.ui.h:6
msgid "Cancel"
msgstr "Скасаваць"

#: data/fingwit/fingwit.ui.h:7
msgid "Delete this fingerprint"
msgstr "Выдаліць гэты адбітак"

#: data/fingwit/fingwit.ui.h:8
msgid "Add a fingerprint"
msgstr "Дадаць адбітак"
