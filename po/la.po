#: data/fingwit.desktop.in:3 fingwit:81 data/fingwit/fingwit.ui.h:9
msgid "Fingerprints"
msgstr "Sigillum digitale"

#: data/fingwit.desktop.in:4 fingwit:134 data/fingwit/fingwit.ui.h:10
msgid "Fingerprint configuration tool"
msgstr "Instrumenta sigilli digitalis configurandi"

#: data/fingwit.desktop.in:11
msgid "fingerprint;authentication;security;biometric;"
msgstr "sigillumdigitale;authenticatio;securitas;biometricum;"

#: fingwit:39
msgid "Right index finger"
msgstr "Dexter digitus salutaris"

#: fingwit:40
msgid "Right middle finger"
msgstr "Dexter digitus medius"

#: fingwit:41
msgid "Right ring finger"
msgstr "Dexter digitus anularis"

#: fingwit:42
msgid "Right little finger"
msgstr "Dexter digitulus"

#: fingwit:43
msgid "Right thumb"
msgstr "Dexter pollex"

#: fingwit:44
msgid "Left index finger"
msgstr "Laevus digitus salutaris"

#: fingwit:45
msgid "Left middle finger"
msgstr "Laevus digitus medius"

#: fingwit:46
msgid "Left ring finger"
msgstr "Laevus digitus anularis"

#: fingwit:47
msgid "Left little finger"
msgstr "Laevus digitulus"

#: fingwit:48
msgid "Left thumb"
msgstr "Laevus pollex"

#: fingwit:98
msgid "Disable fingerprint authentication"
msgstr "Debilita sigillorum digitalum authenticationem"

#: fingwit:102 fingwit:132
msgid "About"
msgstr "Circa"

#: fingwit:107
msgid "Quit"
msgstr "Linque"

#: fingwit:275
msgid "Place your finger on the scanner..."
msgstr "Impone digitum scansorio..."

#: fingwit:293
msgid "Well done! Your fingerprint was saved successfully."
msgstr "Bene fecisti! Sigillum digitale est nunc servatum."

#: fingwit:299
#, python-format
msgid "Good scan (%d so far)! Do it again..."
msgstr "Bona scansio (%d adhuc)! Iterum age..."

#: fingwit:302
msgid "Try again..."
msgstr "Retenta..."

#: fingwit:305
msgid "Sorry, your fingerprint could not be saved."
msgstr "Paenitet, sigillum digitale servari non potuit."

#: fingwit:310
msgid "This fingerprint is already saved, use a different finger."
msgstr "Hoc sigillum digitale iam servatum, utere digitum alium."

#: fingwit:315
msgid "This device cannot store any more fingerprints."
msgstr "Haec machina tenere plus sigillorum digitalum nequit."

#: fingwit:320
msgid "An unknown error occured."
msgstr "Error incognitus cecidit."

#: data/fingwit/fingwit.ui.h:1
msgid "No fingerprint reader detected"
msgstr "Lector sigillorum digitalum non invenitur"

#: data/fingwit/fingwit.ui.h:2
msgid "Fingerprint authentication disabled"
msgstr "Authenticatio sigilli digitalis debilitata"

#: data/fingwit/fingwit.ui.h:3
msgid "Enable"
msgstr "Habilita"

#: data/fingwit/fingwit.ui.h:4
msgid "Choose a finger to configure it:"
msgstr "Elige digitum ut configures:"

#: data/fingwit/fingwit.ui.h:5
msgid "Active fingerprints are highlighted in green."
msgstr "Sigilla digitales activae illuminantur viridi"

#: data/fingwit/fingwit.ui.h:6
msgid "Cancel"
msgstr "Rescinde"

#: data/fingwit/fingwit.ui.h:7
msgid "Delete this fingerprint"
msgstr "Dele hoc sigillum digitale"

#: data/fingwit/fingwit.ui.h:8
msgid "Add a fingerprint"
msgstr "Adde sigillum digitale"
