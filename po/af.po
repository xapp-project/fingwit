#: data/fingwit.desktop.in:3 fingwit:81 data/fingwit/fingwit.ui.h:9
msgid "Fingerprints"
msgstr "Vingerafdrukke"

#: data/fingwit.desktop.in:4 fingwit:134 data/fingwit/fingwit.ui.h:10
msgid "Fingerprint configuration tool"
msgstr "Gereedskap vir vingerafdrukopstelling"

#: data/fingwit.desktop.in:11
msgid "fingerprint;authentication;security;biometric;"
msgstr ""
"fingerprint;authentication;security;biometric;vingerafdruk;stawing;sekuriteit"
";biometries;"

#: fingwit:39
msgid "Right index finger"
msgstr "Regterwysvinger"

#: fingwit:40
msgid "Right middle finger"
msgstr "Regtermiddelvinger"

#: fingwit:41
msgid "Right ring finger"
msgstr "Regterringvinger"

#: fingwit:42
msgid "Right little finger"
msgstr "Regterpinkie"

#: fingwit:43
msgid "Right thumb"
msgstr "Regterduim"

#: fingwit:44
msgid "Left index finger"
msgstr "Linkerwysvinger"

#: fingwit:45
msgid "Left middle finger"
msgstr "Linkermiddelvinger"

#: fingwit:46
msgid "Left ring finger"
msgstr "Linkerringvinger"

#: fingwit:47
msgid "Left little finger"
msgstr "Linkerpinkie"

#: fingwit:48
msgid "Left thumb"
msgstr "Linkerduim"

#: fingwit:98
msgid "Disable fingerprint authentication"
msgstr "Deaktiveer vingerafdrukstawing"

#: fingwit:102 fingwit:132
msgid "About"
msgstr "Aangaande"

#: fingwit:107
msgid "Quit"
msgstr "Sluit af"

#: fingwit:275
msgid "Place your finger on the scanner..."
msgstr "Plaas jou vinger op die skandeerder..."

#: fingwit:293
msgid "Well done! Your fingerprint was saved successfully."
msgstr "Goed gedoen! Jou vingerafdruk is suksesvol gestoor."

#: fingwit:299
#, python-format
msgid "Good scan (%d so far)! Do it again..."
msgstr "Goeie skandering (%d tot dusver)! Doen dit weer..."

#: fingwit:302
msgid "Try again..."
msgstr "Probeer weer..."

#: fingwit:305
msgid "Sorry, your fingerprint could not be saved."
msgstr "Jammer, jou vingerafdruk kon nie gestoor word nie."

#: fingwit:310
msgid "This fingerprint is already saved, use a different finger."
msgstr "Hierdie vingerafdruk is reeds gestoor, gebruik 'n ander vinger."

#: fingwit:315
msgid "This device cannot store any more fingerprints."
msgstr "Hierdie toestel kan nie meer vingerafdrukke stoor nie."

#: fingwit:320
msgid "An unknown error occured."
msgstr "'n Onbekende fout het voorgekom."

#: data/fingwit/fingwit.ui.h:1
msgid "No fingerprint reader detected"
msgstr "Geen vingerafdrukleser is opgespoor nie"

#: data/fingwit/fingwit.ui.h:2
msgid "Fingerprint authentication disabled"
msgstr "Vingerafdrukstawing is gedeaktiveer"

#: data/fingwit/fingwit.ui.h:3
msgid "Enable"
msgstr "Aktiveer"

#: data/fingwit/fingwit.ui.h:4
msgid "Choose a finger to configure it:"
msgstr "Kies 'n vinger om dit op te stel:"

#: data/fingwit/fingwit.ui.h:5
msgid "Active fingerprints are highlighted in green."
msgstr "Aktiewe vingerafdrukke word in groen uitgelig."

#: data/fingwit/fingwit.ui.h:6
msgid "Cancel"
msgstr "Kanselleer"

#: data/fingwit/fingwit.ui.h:7
msgid "Delete this fingerprint"
msgstr "Skrap hierdie vingerafdruk"

#: data/fingwit/fingwit.ui.h:8
msgid "Add a fingerprint"
msgstr "Voeg 'n vingerafdruk by"
